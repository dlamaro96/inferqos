# syntax=docker/dockerfile:1.7
FROM rust:1.98-bookworm@sha256:82150a52ec202c1b14d7817e14516c392bb7f5cfebd88f1ed531cb37ebd39922 AS build
ARG INFERQOS_GIT_SHA=development
ENV INFERQOS_GIT_SHA=${INFERQOS_GIT_SHA}
ENV INFERQOS_BUILD_TARGET=linux/amd64
WORKDIR /src
COPY . .
RUN cargo build --locked --release --bin inferqos

FROM gcr.io/distroless/cc-debian12:nonroot@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f
COPY --from=build /src/target/release/inferqos /usr/local/bin/inferqos
COPY --from=build /src/examples/minimal/demo.yaml /etc/inferqos/demo.yaml
USER nonroot:nonroot
EXPOSE 8080 9090
ENTRYPOINT ["/usr/local/bin/inferqos"]
CMD ["serve", "--config", "/etc/inferqos/demo.yaml"]
