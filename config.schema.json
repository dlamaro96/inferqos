{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "admin": {
      "$ref": "#/$defs/AdminConfig"
    },
    "apiVersion": {
      "type": "string"
    },
    "coordinator": {
      "$ref": "#/$defs/CoordinatorConfig",
      "default": {
        "type": "memory"
      }
    },
    "kind": {
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/Limits",
      "default": {
        "allow_unsafe_uncoordinated_ha": false,
        "decision_history": 2048,
        "expected_replicas": 1,
        "total_queue_bytes": 268435456,
        "total_queue_depth": 10000
      }
    },
    "mode": {
      "$ref": "#/$defs/Mode",
      "default": "shadow"
    },
    "policies": {
      "$ref": "#/$defs/Policies",
      "default": {
        "api_keys": {},
        "applications": {},
        "tenants": {}
      }
    },
    "pools": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PoolConfig"
      }
    },
    "server": {
      "$ref": "#/$defs/ServerConfig"
    },
    "service_classes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ServiceClassConfig"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "server",
    "admin",
    "service_classes",
    "pools"
  ],
  "$defs": {
    "AdminConfig": {
      "type": "object",
      "properties": {
        "bearer_token_env": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "expose_decisions": {
          "type": "boolean",
          "default": false
        },
        "listen": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "listen"
      ]
    },
    "ApplicationPolicy": {
      "type": "object",
      "properties": {
        "allowed_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "max_concurrency": {
          "type": "integer",
          "format": "uint",
          "default": 100,
          "minimum": 0
        },
        "permitted_pools": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "tenant": {
          "type": "string"
        },
        "weight": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "tenant",
        "allowed_classes"
      ]
    },
    "AuthConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "env": {
              "type": "string"
            },
            "header": {
              "type": "string",
              "default": "api-key"
            },
            "type": {
              "type": "string",
              "const": "api-key"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "env"
          ]
        },
        {
          "type": "object",
          "properties": {
            "env": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "bearer"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "env"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ambient"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "CoordinatorConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "memory"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "lease_ttl": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "valkey"
            },
            "url_env": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "url_env",
            "lease_ttl"
          ]
        }
      ]
    },
    "IdentityMapping": {
      "type": "object",
      "properties": {
        "application": {
          "type": "string"
        },
        "principal": {
          "type": "string"
        },
        "tenant": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "principal",
        "tenant",
        "application"
      ]
    },
    "Limits": {
      "type": "object",
      "properties": {
        "allow_unsafe_uncoordinated_ha": {
          "type": "boolean",
          "default": false
        },
        "decision_history": {
          "type": "integer",
          "format": "uint",
          "default": 2048,
          "minimum": 0
        },
        "expected_replicas": {
          "type": "integer",
          "format": "uint",
          "default": 1,
          "minimum": 0
        },
        "total_queue_bytes": {
          "type": "integer",
          "format": "uint",
          "default": 268435456,
          "minimum": 0
        },
        "total_queue_depth": {
          "type": "integer",
          "format": "uint",
          "default": 10000,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Mode": {
      "type": "string",
      "enum": [
        "shadow",
        "enforce"
      ]
    },
    "Policies": {
      "type": "object",
      "properties": {
        "api_keys": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/IdentityMapping"
          },
          "default": {}
        },
        "applications": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ApplicationPolicy"
          },
          "default": {}
        },
        "tenants": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TenantPolicy"
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "PoolConfig": {
      "type": "object",
      "properties": {
        "allowed_hosts": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "auth": {
          "$ref": "#/$defs/AuthConfig",
          "default": {
            "type": "none"
          }
        },
        "capacity_units": {
          "type": "number",
          "format": "double"
        },
        "deployment": {
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint": {
          "type": "string"
        },
        "initial_safety_factor": {
          "type": "number",
          "format": "double",
          "default": 1.15
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "$ref": "#/$defs/ProviderKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "endpoint",
        "capacity_units"
      ]
    },
    "ProviderKind": {
      "type": "string",
      "enum": [
        "azure-openai",
        "aws-bedrock",
        "gcp-vertex",
        "openai-compatible",
        "fake"
      ]
    },
    "ServerConfig": {
      "type": "object",
      "properties": {
        "listen": {
          "type": "string"
        },
        "max_body_bytes": {
          "type": "integer",
          "format": "uint",
          "default": 16777216,
          "minimum": 0
        },
        "spool_threshold_bytes": {
          "type": "integer",
          "format": "uint",
          "default": 262144,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "listen"
      ]
    },
    "ServiceClassConfig": {
      "type": "object",
      "properties": {
        "default_deadline": {
          "type": "string"
        },
        "max_queue": {
          "type": "string"
        },
        "max_queued": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "weight": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "weight",
        "default_deadline",
        "max_queue",
        "max_queued"
      ]
    },
    "TenantPolicy": {
      "type": "object",
      "properties": {
        "guaranteed_share": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "max_concurrency": {
          "type": "integer",
          "format": "uint",
          "default": 100,
          "minimum": 0
        },
        "max_share": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "weight": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}